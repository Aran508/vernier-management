# Reference copy of every setting the app understands.
#
# You do NOT need to copy this file. The first time you run `npm run dev`,
# a .env.local is created for you with a freshly generated JWT_SECRET and
# sensible defaults. Edit that file if you want to turn on email.
#
# This file just documents what each value means.

# --- Auth ---
# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Set to "true" once the app is served over HTTPS (see DEPLOYMENT.md).
# Leave "false" for plain-HTTP internal network deployments — a secure
# cookie silently fails to be set (and login will appear broken) over HTTP.
COOKIE_SECURE=false

# --- Email (SMTP) ---
# Optional. If left blank, the app logs emails to the console instead of
# sending them, so nothing breaks before you configure this.
#
# Works with any SMTP provider — examples:
#
# Microsoft 365 / Outlook:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# Google Workspace / Gmail (requires an "App Password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# Internal company mail relay: ask your IT/mail admin for host + port.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PED Tool Room <notifications@yourcompany.com>"
